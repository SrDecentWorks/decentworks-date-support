      def end_of_january: -> ::Date
      def all_january: -> ::Range[::Date]
      def beginning_of_january?: -> bool
      def end_of_january?: -> bool
      def in_january?: -> bool

      def beginning_of_february: -> ::Date
      def end_of_february: -> ::Date
