module Decentworks
  module DateSupport
    # ::Time / ::DateTime / ::ActiveSupport::TimeWithZone が備えている
    # ActiveSupport（DateAndTime::Calculations）由来のメソッド。
    #
    # TimeExtension のself型として指定することで、モジュール内部での
    # レシーバ省略呼び出しを型検査できるようにする。
    interface _DateTimeCalculations
      def year: () -> ::Integer
      def month: () -> ::Integer
      def all_day: () -> ::Range[untyped]
      def beginning_of_day: () -> untyped
      def end_of_day: () -> untyped
      def beginning_of_week: (?untyped start_day) -> untyped
      def beginning_of_month: () -> untyped
      def end_of_month: () -> untyped
      def months_ago: (untyped months) -> untyped
      def months_since: (untyped months) -> untyped
      def change: (untyped options) -> untyped
      def advance: (untyped options) -> untyped
    end

    # ::Time / ::DateTime / ::ActiveSupport::TimeWithZone に共通の日時拡張
    module TimeExtension : _DateTimeCalculations
      module ClassMethods
        def whole_months_elapsed: (from: untyped, to: untyped) -> ::Integer
      end

      def self.included: (untyped base) -> untyped

      def beginning_of_this_week: -> self
      def end_of_this_week: -> self
      def all_this_week: -> ::Range[self]

      def beginning_of_this_month: -> self
      def end_of_this_month: -> self
      def all_this_month: -> ::Range[self]

      def two_months_ago: -> self
      def three_months_ago: -> self
      def four_months_ago: -> self
      def five_months_ago: -> self
      def six_months_ago: -> self
      def half_year_ago: -> self
      def seven_months_ago: -> self
      def eight_months_ago: -> self
      def nine_months_ago: -> self
      def ten_months_ago: -> self
      def eleven_months_ago: -> self

      def two_months_since: -> self
      def three_months_since: -> self
      def four_months_since: -> self
      def five_months_since: -> self
      def six_months_since: -> self
      def half_year_since: -> self
      def seven_months_since: -> self
      def eight_months_since: -> self
      def nine_months_since: -> self
      def ten_months_since: -> self
      def eleven_months_since: -> self

      def beginning_of_january: -> self
      def end_of_january: -> self
      def all_january: -> ::Range[self]
      def beginning_of_january?: -> bool
      def end_of_january?: -> bool
      def in_january?: -> bool

      def beginning_of_february: -> self
      def end_of_february: -> self
      def all_february: -> ::Range[self]
      def beginning_of_february?: -> bool
      def end_of_february?: -> bool
      def in_february?: -> bool

      def beginning_of_march: -> self
      def end_of_march: -> self
      def all_march: -> ::Range[self]
      def beginning_of_march?: -> bool
      def end_of_march?: -> bool
      def in_march?: -> bool

      def beginning_of_april: -> self
      def end_of_april: -> self
      def all_april: -> ::Range[self]
      def beginning_of_april?: -> bool
      def end_of_april?: -> bool
      def in_april?: -> bool

      def beginning_of_may: -> self
      def end_of_may: -> self
      def all_may: -> ::Range[self]
      def beginning_of_may?: -> bool
      def end_of_may?: -> bool
      def in_may?: -> bool

      def beginning_of_june: -> self
      def end_of_june: -> self
      def all_june: -> ::Range[self]
      def beginning_of_june?: -> bool
      def end_of_june?: -> bool
      def in_june?: -> bool

      def beginning_of_july: -> self
      def end_of_july: -> self
      def all_july: -> ::Range[self]
      def beginning_of_july?: -> bool
      def end_of_july?: -> bool
      def in_july?: -> bool

      def beginning_of_august: -> self
      def end_of_august: -> self
      def all_august: -> ::Range[self]
      def beginning_of_august?: -> bool
      def end_of_august?: -> bool
      def in_august?: -> bool

      def beginning_of_september: -> self
      def end_of_september: -> self
      def all_september: -> ::Range[self]
      def beginning_of_september?: -> bool
      def end_of_september?: -> bool
      def in_september?: -> bool

      def beginning_of_october: -> self
      def end_of_october: -> self
      def all_october: -> ::Range[self]
      def beginning_of_october?: -> bool
      def end_of_october?: -> bool
      def in_october?: -> bool

      def beginning_of_november: -> self
      def end_of_november: -> self
      def all_november: -> ::Range[self]
      def beginning_of_november?: -> bool
      def end_of_november?: -> bool
      def in_november?: -> bool

      def beginning_of_december: -> self
      def end_of_december: -> self
      def all_december: -> ::Range[self]
      def beginning_of_december?: -> bool
      def end_of_december?: -> bool
      def in_december?: -> bool

      def beginning_of_first_quarter: -> self
      def end_of_first_quarter: -> self
      def all_first_quarter: -> ::Range[self]
      def beginning_of_first_quarter?: -> bool
      def end_of_first_quarter?: -> bool
      def in_first_quarter?: -> bool

      def beginning_of_second_quarter: -> self
      def end_of_second_quarter: -> self
      def all_second_quarter: -> ::Range[self]
      def beginning_of_second_quarter?: -> bool
      def end_of_second_quarter?: -> bool
      def in_second_quarter?: -> bool

      def beginning_of_third_quarter: -> self
      def end_of_third_quarter: -> self
      def all_third_quarter: -> ::Range[self]
      def beginning_of_third_quarter?: -> bool
      def end_of_third_quarter?: -> bool
      def in_third_quarter?: -> bool

      def beginning_of_fourth_quarter: -> self
      def end_of_fourth_quarter: -> self
      def all_fourth_quarter: -> ::Range[self]
      def beginning_of_fourth_quarter?: -> bool
      def end_of_fourth_quarter?: -> bool
      def in_fourth_quarter?: -> bool

      def beginning_of_first_half: -> self
      def end_of_first_half: -> self
      def all_first_half: -> ::Range[self]
      def beginning_of_first_half?: -> bool
      def end_of_first_half?: -> bool
      def in_first_half?: -> bool

      def beginning_of_second_half: -> self
      def end_of_second_half: -> self
      def all_second_half: -> ::Range[self]
      def beginning_of_second_half?: -> bool
      def end_of_second_half?: -> bool
      def in_second_half?: -> bool

      def this_quarter_number: -> ::Integer
      def beginning_of_this_quarter: -> self
      def end_of_this_quarter: -> self
      def all_this_quarter: -> ::Range[self]

      def this_half_number: -> ::Integer
      def beginning_of_this_half: -> self
      def end_of_this_half: -> self
      def all_this_half: -> ::Range[self]

      def fiscal_year: -> ::Integer
      def beginning_of_fiscal_year: -> self
      def end_of_fiscal_year: -> self
      def all_fiscal_year: -> ::Range[self]
    end
  end
end
